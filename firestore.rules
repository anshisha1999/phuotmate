rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile documents
    match /users/{userId} {
      allow read, write: if true;
    }

    // Trips collection
    match /trips/{tripId} {
      allow read, write: if true;
    }

    // Default match-all rule for collaborative real-time synchronization
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
